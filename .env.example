# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rwa_backoffice
DB_SSL=false
DB_LOGGING=false

# ── JWT / 2FA ─────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_REFRESH_EXPIRES_IN=7d
JWT_TWO_FACTOR_EXPIRES_IN=5m
TWO_FACTOR_ISSUER=RWA Exchange Backoffice

# ── Blockchain (EVM) ──────────────────────────────────
EVM_DEFAULT_CHAIN_ID=11155111
EVM_RPC_URL=https://rpc.sepolia.org
