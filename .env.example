# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── MongoDB ───────────────────────────────────────────
# Las transacciones multi-documento requieren replica set (o Atlas).
# Local:  mongodb://localhost:27017/rwa_backoffice?replicaSet=rs0
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/rwa_backoffice?retryWrites=true&w=majority
# (con Docker Compose esta variable la construye docker-compose.yml; no hace falta definirla)
MONGODB_URI=mongodb://localhost:27017/rwa_backoffice?replicaSet=rs0
# true en desarrollo (por defecto), false en producción
MONGODB_AUTO_INDEX=true

# ── JWT / 2FA ─────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_REFRESH_EXPIRES_IN=7d
JWT_TWO_FACTOR_EXPIRES_IN=5m
TWO_FACTOR_ISSUER=RWA Exchange Backoffice

# ── Blockchain (EVM) ──────────────────────────────────
EVM_DEFAULT_CHAIN_ID=11155111
EVM_RPC_URL=https://rpc.sepolia.org

# ── Seed (npm run seed / docker compose --profile tools run --rm seed) ──
SEED_ADMIN_EMAIL=admin@exchange.com
SEED_ADMIN_PASSWORD=

# ── Docker (docker-compose.yml) ───────────────────────
# Usa solo letras y números en las contraseñas (van dentro de una URI de MongoDB).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_DB=rwa_backoffice
MONGO_APP_USER=rwa_app
MONGO_APP_PASSWORD=change-me-app-password
API_PORT=3000
MONGO_PORT=27017
