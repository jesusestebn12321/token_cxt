# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── MongoDB (Prisma) ──────────────────────────────────
DATABASE_URL=mongodb://root:change-me-db-password@localhost:27017/rwa_backoffice?authSource=admin&replicaSet=rs0

# ── JWT / 2FA ─────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_TWO_FACTOR_EXPIRES_IN=5m
TWO_FACTOR_ISSUER=RWA Exchange Backoffice
# true solo en local, si no hay correo. En producción debe quedar en false.
AUTH_EXPOSE_RESET_TOKEN=false

# ── Docker (docker-compose.yml) ───────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-db-password
MONGO_DB=rwa_backoffice
API_PORT=3000
MONGO_PORT=27017
